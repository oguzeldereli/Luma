@model Luma.Server.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Sign in";
}

<h1>Sign in</h1>
<p class="sub">Enter your email to continue. Luma uses passwordless sign-in.</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error">@Model.Error</div>
}

<form method="post" action="/login">
    @Html.AntiForgeryToken()
    <label for="email">Email address</label>
    <input type="email" id="email" name="email" value="@Model.Email" placeholder="you@example.com" required autofocus />
    <button type="submit">Continue</button>
</form>

@if (Model.RegistrationEnabled)
{
    <p class="muted" style="margin-top:16px;">No account? Just enter your email — we'll help you create one.</p>
}
