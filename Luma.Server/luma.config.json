{
  "Luma": {
    "Database": {
      "Provider": "Microsoft.EntityFrameworkCore.Sqlite",
      "ConnectionString": "Data Source=auth.db"
    },
    "AuthenticationServer": {
      "AuthCodeStateIdCookieName": "Luma.AuthCodeStateId",
      "AuthCodeStateIdCookieValidForMinutes": 10, // has to be between 5 and 60 (inclusive)
      "UserLoginSessionsCookieName": "Luma.UserLoginSession",
      "UserLoginSessionsValidForMinutes": 1440, // has to be between 60 and 10080 (inclusive)
      "EnableUserRegisterationByUI": true,
      "UseCustomFiles": false,
      "CustomFiles": {
        "ViewMode": "Razor", // or Static
        "Path": "./wwwroot"
      }
    },
    "Email": {
      // Logging: writes the email (incl. magic links / codes) to the application log. Great for local development.
      // Smtp: delivers via the SMTP server configured below.
      "DeliveryMethod": "Logging",
      "FromAddress": "no-reply@luma.local",
      "FromName": "Luma Auth",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UseStartTls": true,
        "Username": "",
        "Password": ""
      }
    },
    "OAuth": {
      "SupportedScopes": [ "openid", "profile", "email", "phone", "address" ],
      "ParExpirationSeconds": 90, // has to be between 60 and 120 (inclusive)
      "AuthorizationCode": {
        "ValidForSeconds": 90 // has to be between 60 and 120 (inclusive)
      },
      "Clients": [
        {
          // Confidential client. Secret (plain) for local testing: "luma-dev-secret"
          "ClientId": "luma-self-hosted",
          "DefaultPostLogoutRedirectUri": "https://localhost/signout-callback-oidc",
          "PostLogoutRedirectUris": [ "https://localhost/signout-callback-oidc" ],
          "DefaultResource": "https://localhost",
          "Resources": [ "https://localhost" ],
          "ClientSecretSHA256_Base64": "fmiAFuUBIch2n4ensNUEV4zVKRnxpcHU+6TCUbWwHlQ=",
          "DisplayName": "Luma Auth",
          "DefaultRedirectUri": "https://localhost/callback",
          "RedirectUris": [ "https://localhost/callback" ],
          "AllowedGrantTypes": [ "client_credentials", "authorization_code", "refresh_token" ],
          "DefaultScope": "openid profile email",
          "AllowedScopes": [ "openid", "profile", "email" ],
          "IsConfidential": true
        },
        {
          // Public client (e.g. SPA / native). PKCE is mandatory for public clients.
          "ClientId": "luma-spa",
          "DefaultPostLogoutRedirectUri": "https://localhost/signout-callback-oidc",
          "PostLogoutRedirectUris": [ "https://localhost/signout-callback-oidc" ],
          "DefaultResource": "https://localhost",
          "Resources": [ "https://localhost" ],
          "ClientSecretSHA256_Base64": "",
          "DisplayName": "Luma SPA",
          "DefaultRedirectUri": "https://localhost/callback",
          "RedirectUris": [ "https://localhost/callback" ],
          "AllowedGrantTypes": [ "authorization_code", "refresh_token" ],
          "DefaultScope": "openid profile email",
          "AllowedScopes": [ "openid", "profile", "email" ],
          "IsConfidential": false
        }
      ]
    },
    "Tokens": {
      "MagicLinkToken": {
        "ValidForMinutes": 15, // has to be smaller than or equal to 20
        "CodeLength": 32 // has to be between 32 and 64 (inclusive)
      },
      "NumericCodeToken": {
        "ValidForMinutes": 10, // has to be smaller than or equal to 20
        "DigitCount": 6 // has to be between 6 and 12 (inclusive)
      },
      "AccessToken": {
        "Issuer": "Luma",
        "TokenType": "Jwt", // or Opaque
        "ValidForMinutes": 15 // has to be between 10 and 30 (inclusive)
      },
      "RefreshToken": {
        "ValidForDays": 30 // has to be between 7 and 90 (inclusive)
      }
    },
    "Keys": {
      "Hmac": {
        "DefaultKeyId": "V1",
        "Keys": {
          // "key-id": "base64-encoded-256-bit-key". Replace this dev key in production
          // or supply it via the LUMA_HMACSHA256_KEY_V1 environment variable.
          "V1": "ZjSs+7o5vjiWLfAXO9ab/Ap/TVX1mA2oZvScbMKi13E="
        }
      },
      "Jwt": {
        "SigningAlgorithm": "RS256", // or ES256
        "DefaultKeyId": "V1",
        "Keys": {
          "V1": {
            "PrivateKeyPath": "./Keys/private.pem",
            "PublicKeyPath": "./Keys/public.pem"
          }
        }
      }
    }
  }
}
